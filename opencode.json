{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["CLAUDE.md"],
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "cargo test*": "allow",
      "cargo check*": "allow",
      "ls*": "allow",
      "wc*": "allow"
    },
    "external_directory": { "~/.cargo/**": "allow" }
  }
}
